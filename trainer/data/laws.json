дёжный","wrong":["надёжный","нереальный"],"a":[9.643,10.536]},{"en":"inexperienced","ru":"неопытный","wrong":["опытный","экспериментальный"],"a":[10.786,11.843]},{"en":"disapprove","ru":"не одобрять","wrong":["одобрять","доказывать"],"a":[12.093,12.924]},{"en":"unload","ru":"разгрузить","wrong":["загрузить","одолжить"],"a":[13.174,14.199]}],"pairs":[],"count":0,"audio":"audio/laws/neg.mp3?v=8ac0067cee"},{"id":"again","title":"re- (снова), mis- (неправильно), over- (слишком), pre- (до)","kind":"prefix","rule":"re- значит \"снова, заново\", как русское пере-: write — rewrite (переписать). mis- — \"неправильно\": understand — misunderstand (неправильно понять). over- — \"слишком\": eat — overeat (переедать). pre- — \"до, заранее\": school — preschool (дошкольный). Ловушки: в ready, real, reach, present и pretty никакой приставки нет — это корень.","pattern":"^(re|mis|over|pre)","examples":[{"en":"rewrite","ru":"переписать","a":[0.024,0.549]},{"en":"reuse","ru":"использовать снова","a":[0.799,1.618]},{"en":"misunderstand","ru":"неправильно понять","a":[1.868,2.793]},{"en":"overeat","ru":"переедать","a":[3.043,3.668]},{"en":"oversleep","ru":"проспать","a":[3.918,4.787]},{"en":"preschool","ru":"дошкольный","a":[5.036,5.674]}],"guess":[{"en":"repaint","ru":"перекрасить","wrong":["нарисовать","покрасить впервые"],"a":[5.924,6.68]},{"en":"reconsider","ru":"пересмотреть, передумать","wrong":["рассмотреть впервые","согласиться"],"a":[6.93,7.761]},{"en":"mistreat","ru":"плохо обращаться","wrong":["угостить","вылечить"],"a":[8.011,8.849]},{"en":"misleading","ru":"вводящий в заблуждение","wrong":["руководящий","пропавший без вести"],"a":[9.099,9.799]},{"en":"overestimate","ru":"переоценить","wrong":["недооценить","оценить точно"],"a":[10.049,10.993]},{"en":"overwork","ru":"перерабатывать, переутомляться","wrong":["остаться без работы","делать домашнюю работу"],"a":[11.243,11.999]},{"en":"prehistoric","ru":"доисторический","wrong":["исторический","современный"],"a":[12.249,13.168]},{"en":"prejudge","ru":"судить заранее","wrong":["судья","оправдать"],"a":[13.418,14.405]}],"pairs":[],"count":0,"audio":"audio/laws/again.mp3?v=78fd0d914b"},{"id":"doer","title":"-er, -or: тот, кто делает (teacher, actor)","kind":"suffix","rule":"Окончания -er и -or делают из глагола того, кто действует: teach — teacher (учитель), act — actor (актёр), drive — driver (водитель). Часто и по-русски -ер или -ор: designer — дизайнер, director — директор. Так же называют приборы: heater — обогреватель. Ловушки: -er бывает сравнением (bigger, faster) и просто частью слова: water, mother, never.","pattern":"(er|or)$","examples":[{"en":"teacher","ru":"учитель","a":[0.024,0.499]},{"en":"driver","ru":"водитель","a":[0.749,1.293]},{"en":"singer","ru":"певец","a":[1.543,2.011]},{"en":"player","ru":"игрок","a":[2.261,2.674]},{"en":"actor","ru":"актёр","a":[2.924,3.418]},{"en":"writer","ru":"писатель","a":[3.668,4.274]}],"guess":[{"en":"listener","ru":"слушатель","wrong":["слушание","листовка"],"a":[4.524,5.111]},{"en":"employer","ru":"работодатель","wrong":["сотрудник, работник","безработный"],"a":[5.361,5.999]},{"en":"translator","ru":"переводчик","wrong":["трансляция","транспорт"],"a":[6.249,7.143]},{"en":"follower","ru":"последователь, подписчик","wrong":["цветочник","лидер"],"a":[7.393,8.03]},{"en":"viewer","ru":"зритель","wrong":["вид из окна","экран"],"a":[8.28,8.736]},{"en":"seller","ru":"продавец","wrong":["подвал","покупатель"],"a":[8.986,9.568]},{"en":"voter","ru":"избиратель","wrong":["вода","голосование"],"a":[9.818,10.236]},{"en":"explorer","ru":"исследователь","wrong":["взрывник","экспорт"],"a":[10.486,11.474]}],"pairs":[],"count":0,"audio":"audio/laws/doer.mp3?v=a2d09d7097"},{"id":"fulless","title":"-ful (полный), -less (без): useful, useless","kind":"suffix","rule":"-ful значит \"полный чего-то\", -less — \"без чего-то\": use — useful (полезный) — useless (бесполезный), hope — hopeful (с надеждой) — hopeless (безнадёжный). По-русски -less часто равно без- или бес-. Ловушки: unless = если не, nevertheless = тем не менее; spoonful и handful — это мера: полная ложка, горсть.","pattern":"(ful|less)$","examples":[{"en":"useful","ru":"полезный","a":[0.024,0.555]},{"en":"useless","ru":"бесполезный","a":[0.805,1.562]},{"en":"helpful","ru":"готовый помочь, полезный","a":[1.812,2.299]},{"en":"homeless","ru":"бездомный","a":[2.549,3.161]},{"en":"careful","ru":"осторожный","a":[3.411,3.899]},{"en":"careless","ru":"небрежный, беспечный","a":[4.149,4.649]}],"guess":[{"en":"harmless","ru":"безвредный","wrong":["вредный","гармоничный"],"a":[4.899,5.449]},{"en":"priceless","ru":"бесценный","wrong":["дешёвый","бесплатный"],"a":[5.699,6.455]},{"en":"endless","ru":"бесконечный","wrong":["законченный","конечный"],"a":[6.705,7.268]},{"en":"painful","ru":"болезненный","wrong":["безболезненный","покрашенный"],"a":[7.518,8.018]},{"en":"tasteless","ru":"безвкусный","wrong":["вкусный","проверенный"],"a":[8.268,9.199]},{"en":"doubtful","ru":"сомнительный, неуверенный","wrong":["уверенный","двойной"],"a":[9.449,10.055]},{"en":"truthful","ru":"правдивый","wrong":["лживый","доверчивый"],"a":[10.305,10.886]},{"en":"pointless","ru":"бессмысленный","wrong":["точный","острый"],"a":[11.136,12.136]}],"pairs":[],"count":0,"audio":"audio/laws/fulless.mp3?v=37cf0e2a4e"},{"id":"nessly","title":"-ness (состояние), -ly (наречие), -able (можно)","kind":"suffix","rule":"-ness делает из прилагательного состояние: kind — kindness (доброта), dark — darkness (темнота). -ly делает наречие: quick — quickly (быстро). -able значит \"можно сделать\": wash — washable (можно стирать). Ловушки: friendly, lovely и lonely — прилагательные, а не наречия; в table и cable окончания нет; comfortable — просто \"удобный\".","pattern":"(ness|ly|able)$","examples":[{"en":"kindness","ru":"доброта","a":[0.024,0.599]},{"en":"darkness","ru":"темнота","a":[0.849,1.462]},{"en":"quickly","ru":"быстро","a":[1.712,2.293]},{"en":"slowly","ru":"медленно","a":[2.543,3.168]},{"en":"washable","ru":"можно стирать","a":[3.418,4.118]},{"en":"drinkable","ru":"питьевой, можно пить","a":[4.368,4.93]}],"guess":[{"en":"weakness","ru":"слабость","wrong":["неделя","выходные"],"a":[5.18,5.699]},{"en":"tiredness","ru":"усталость","wrong":["усталый","шина"],"a":[5.949,6.855]},{"en":"loneliness","ru":"одиночество","wrong":["одинокий","любимый"],"a":[7.105,7.861]},{"en":"softness","ru":"мягкость","wrong":["программа, софт","мягкий"],"a":[8.111,9.074]},{"en":"breakable","ru":"бьющийся, хрупкий","wrong":["завтрак","прочный"],"a":[9.324,9.937]},{"en":"predictable","ru":"предсказуемый","wrong":["предсказание","предсказатель"],"a":[10.187,10.93]},{"en":"secretly","ru":"тайно","wrong":["секретарь","секретный"],"a":[11.18,12.055]},{"en":"proudly","ru":"гордо","wrong":["гордый","гордость"],"a":[12.305,13.318]}],"pairs":[],"count":0,"audio":"audio/laws/nessly.mp3?v=674956cd38"},{"id":"compound","title":"Сложные слова: break + fast, bed + room","kind":"compound","rule":"Многие слова склеены из двух знакомых: bed + room = bedroom (спальня), rain + coat = raincoat (плащ). Разберите слово на части и сложите смыслы; главная обычно вторая часть: bookshop — магазин, а не книга. Ловушки: смысл не всегда сумма частей: breakfast — завтрак (break + fast = прервать пост), butterfly — бабочка.","pattern":"","examples":[{"en":"bedroom","ru":"спальня","a":[0.024,0.555]},{"en":"classroom","ru":"класс, учебная комната","a":[0.805,1.568]},{"en":"birthday","ru":"день рождения","a":[1.818,2.424]},{"en":"homework","ru":"домашнее задание","a":[2.674,3.33]},{"en":"sunglasses","ru":"солнечные очки","a":[3.58,4.561]},{"en":"bookshop","ru":"книжный магазин","a":[4.811,5.399]}],"guess":[{"en":"firefighter","ru":"пожарный","wrong":["поджигатель","фейерверк"],"a":[5.649,6.574]},{"en":"dishwasher","ru":"посудомоечная машина","wrong":["посудная полка","официант"],"a":[6.824,7.63]},{"en":"skyscraper","ru":"небоскрёб","wrong":["парашютист","самолёт"],"a":[7.88,8.968]},{"en":"newcomer","ru":"новичок","wrong":["новость","комета"],"a":[9.218,9.899]},{"en":"storyteller","ru":"рассказчик","wrong":["продавец магазина","телефонист"],"a":[10.149,10.999]},{"en":"latecomer","ru":"опоздавший","wrong":["поздний ужин","пришедший первым"],"a":[11.249,12.186]},{"en":"loudspeaker","ru":"громкоговоритель","wrong":["болтун","оратор"],"a":[12.436,13.48]},{"en":"lighthouse","ru":"маяк","wrong":["лёгкий домик","люстра"],"a":[13.73,14.743]}],"pairs":[],"count":0,"audio":"audio/laws/compound.mp3?v=01c2e6fa4b"},{"id":"phrasal","title":"Частицы фразовых глаголов: up, down, out, off, back, on","kind":"phrasal","rule":"Глагол с частицей меняет смысл, а частица подсказывает направление: up — вверх или до конца (eat up — доесть), down — вниз или меньше (turn down — убавить), out — наружу (go out — выйти), off — прочь, выключить (take off — снять), back — обратно (come back — вернуться), on — дальше, включить (go on — продолжать). Ловушка: иногда смысл не сложить: give up — сдаться.","pattern":"","examples":[{"en":"stand up","ru":"встать","a":[0.024,0.73]},{"en":"sit down","ru":"сесть","a":[0.98,1.705]},{"en":"go out","ru":"выйти","a":[1.955,2.343]},{"en":"turn off","ru":"выключить","a":[2.593,3.33]},{"en":"come back","ru":"вернуться","a":[3.58,4.118]},{"en":"turn on","ru":"включить","a":[4.368,5.03]}],"guess":[{"en":"write down","ru":"записать","wrong":["переписать","написать снова"],"a":[5.28,5.955]},{"en":"calm down","ru":"успокоиться","wrong":["разозлиться","проснуться"],"a":[6.205,6.818]},{"en":"call back","ru":"перезвонить","wrong":["позвонить впервые","кричать"],"a":[7.068,7.712]},{"en":"pay back","ru":"вернуть долг","wrong":["заплатить вперёд","потратить"],"a":[7.962,8.599]},{"en":"carry on","ru":"продолжать","wrong":["нести наверх","остановиться"],"a":[8.849,9.468]},{"en":"drink up","ru":"допить","wrong":["отпить глоток","налить"],"a":[9.718,10.374]},{"en":"set off","ru":"отправиться в путь","wrong":["приехать","поставить на место"],"a":[10.624,11.393]},{"en":"switch off","ru":"выключить","wrong":["включить","переключить"],"a":[11.643,12.68]}],"pairs":[{"en":"give up","looks":"up = до конца, прочь","ru":"сдаться, бросить"},{"en":"eat up","looks":"up = до конца","ru":"доесть"},{"en":"grow up","looks":"up = вверх","ru":"вырасти, повзрослеть"},{"en":"look up","looks":"up = вверх","ru":"посмотреть вверх; найти в словаре"},{"en":"turn down","looks":"down = меньше","ru":"убавить; отказать"},{"en":"slow down","looks":"down = меньше","ru":"замедлиться, сбавить ход"},{"en":"break down","looks":"down = вниз, рухнуть","ru":"сломаться"},{"en":"find out","looks":"out = наружу, на свет","ru":"узнать, выяснить"},{"en":"take off","looks":"off = прочь","ru":"снять (одежду); взлететь"},{"en":"get off","looks":"off = прочь","ru":"выйти (из автобуса, поезда)"},{"en":"give back","looks":"back = обратно","ru":"вернуть, отдать обратно"},{"en":"put on","looks":"on = на себя","ru":"надеть"}],"count":0,"audio":"audio/laws/phrasal.mp3?v=daf9b7b63e"}]}